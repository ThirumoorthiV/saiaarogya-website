{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/donateus", "destination": "/support-us/donate/", "statusCode": 301 },
    { "source": "/donormanagement", "destination": "/support-us/donate/", "statusCode": 301 },
    { "source": "/donormanagement/:path*", "destination": "/support-us/donate/", "statusCode": 301 },
    { "source": "/terms", "destination": "/policies/terms/", "statusCode": 301 },
    { "source": "/privacypolicy", "destination": "/policies/privacy/", "statusCode": 301 },
    { "source": "/refundpolicy", "destination": "/policies/refund/", "statusCode": 301 },
    { "source": "/home", "destination": "/", "statusCode": 301 },
    { "source": "/te", "destination": "/", "statusCode": 301 },
    { "source": "/te/:path*", "destination": "/:path*", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
