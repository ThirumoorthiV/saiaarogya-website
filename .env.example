# Web3Forms access key (public — safe in client code). Get one at https://web3forms.com using the official hospital email.
VITE_WEB3FORMS_ACCESS_KEY=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXX (optional)
VITE_GA_ID=

# ---- Online donations (Razorpay → Frappe). SERVER-ONLY: set these in Vercel (Project → Settings → Environment Variables), never with a VITE_ prefix ----
# Razorpay Dashboard → Account & Settings → API keys (use test keys first: rzp_test_…)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Webhooks → URL https://www.saiaarogya.hospital/api/razorpay/webhook,
# events: order.paid, subscription.charged — the secret you type there:
RAZORPAY_WEBHOOK_SECRET=
# The Frappe endpoint that records donations (payload: see src/lib/donation.ts)
FRAPPE_WEBHOOK_URL=
# Optional: sent as the Authorization header to Frappe, e.g. "token api_key:api_secret"
FRAPPE_WEBHOOK_AUTH=
# Optional: only these origins may create orders, e.g. https://www.saiaarogya.hospital
ALLOWED_ORIGINS=

# ---- CMS login (Decap CMS, GitHub backend) ----
# GitHub → Settings → Developer settings → OAuth Apps → New:
#   Homepage URL https://www.saiaarogya.hospital   Callback URL https://www.saiaarogya.hospital/api/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
